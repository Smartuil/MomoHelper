{
  "name": "@momo/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=.env src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node --import tsx --env-file=.env src/index.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@hono/node-server": "^1.13.0",
    "@momo/ai": "workspace:*",
    "@momo/core": "workspace:*",
    "@momo/db": "workspace:*",
    "@momo/maimemo": "workspace:*",
    "@momo/types": "workspace:*",
    "drizzle-orm": "^0.44.0",
    "hono": "^4.6.0",
    "node-cron": "^4.0.0",
    "pg": "^8.13.0",
    "tsx": "^4.19.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/node-cron": "^3.0.11",
    "@types/pg": "^8.11.0",
    "typescript": "^5.7.0"
  }
