# 运行环境
NODE_ENV=development
PORT=3000

# 数据库（仅监听本机，绝不对外暴露）
DATABASE_URL=postgres://momo:change-me@127.0.0.1:5432/momohelper

# 墨墨 Token 加密主密钥
# 生成方式：node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
# 注意：该密钥绝不进代码仓库、绝不进数据库备份
MAIMEMO_TOKEN_KEY=change-me
MAIMEMO_TOKEN_KEY_VERSION=1

# DeepSeek
DEEPSEEK_API_KEY=change-me
DEEPSEEK_BASE_URL=https://api.deepseek.com

# 模块开关（本地开发可只开 API）
ENABLE_API=true
ENABLE_WORKER=true
ENABLE_SCHEDULER=true

# 队列并发，2 核 2G 规格建议 2
WORKER_CONCURRENCY=2
