# 环境变量样例（复制为 .env，权限 600，绝不进仓库）

NODE_ENV=production
PORT=3000

# 宝塔 PG 18 实例（仅监听 127.0.0.1）
DATABASE_URL=postgres://momo:CHANGE_ME@127.0.0.1:5432/momohelper

# base64 编码的 32 字节密钥：
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
MAIMEMO_TOKEN_KEY=CHANGE_ME
MAIMEMO_TOKEN_KEY_VERSION=1

DEEPSEEK_API_KEY=CHANGE_ME
DEEPSEEK_BASE_URL=https://api.deepseek.com

# 会话签名密钥（>=16 字符随机串）
SESSION_SECRET=CHANGE_ME

# 微信资质到位前用开发登录（生产显式开启才有 /api/auth/dev）
DEV_LOGIN=true
WECHAT_APP_ID=
WECHAT_APP_SECRET=

ENABLE_API=true
ENABLE_WORKER=true
ENABLE_SCHEDULER=true

# 1G 内存机器：默认 1，上限 2
WORKER_CONCURRENCY=1
